---
import BookCover from './BookCover.astro';
import StarRating from './StarRating.astro';
import { lecturaDelMes } from '../data/lecturas';

const l = lecturaDelMes;
---

<section id="lectura-del-mes" class="pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 grid md:grid-cols-[1.05fr_0.95fr] gap-12 md:gap-20 items-center">
    <div class="reveal">
      <p class="font-mono-label text-xs uppercase tracking-[0.25em] text-plum">
        Lectura del mes · {l.mes} {l.anio}
      </p>

      <h1 class="mt-5 font-display text-4xl sm:text-6xl leading-[1.02] text-balance">
        {l.titulo}
      </h1>
      <p class="mt-4 font-display italic text-xl sm:text-2xl text-ink/70">{l.autora}</p>

      {l.sinopsis && <p class="mt-6 max-w-md text-ink/75 leading-relaxed">{l.sinopsis}</p>}

      <div class="mt-7 flex items-center gap-4">
        <StarRating value={l.veredicto} color="var(--color-plum)" />
        <span class="font-mono-label text-[0.7rem] uppercase tracking-wide text-ink-soft">
          {l.paginas} p. · {l.editorial}
        </span>
      </div>

      <dl class="mt-9 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-7 font-mono-label text-[0.7rem] uppercase tracking-wide">
        <div>
          <dt class="text-ink-soft">Género</dt>
          <dd class="mt-1 normal-case font-body text-sm text-ink">{l.genero}</dd>
        </div>
        <div>
          <dt class="text-ink-soft">Subgénero</dt>
          <dd class="mt-1 normal-case font-body text-sm text-ink">{l.subgenero}</dd>
        </div>
        <div>
          <dt class="text-ink-soft">Reunión</dt>
          <dd class="mt-1 normal-case font-body text-sm text-ink">{l.lugar}</dd>
        </div>
      </dl>
    </div>

    <div class="reveal" data-reveal-delay="120">
      <BookCover titulo={l.titulo} autora={l.autora} color={l.color} slug={l.slug} class="w-full max-w-sm mx-auto shadow-[0_30px_60px_-25px_rgba(21,19,15,0.35)]" />
    </div>
  </div>
</section>
