---
// Si se pasa `slug`, se usa la portada real en public/covers/{slug}.jpg
// (fuente: Open Library). Si no existe o no se pasa slug, cae al bloque
// ilustrado por color como marcador visual.
import type { Color } from '../data/lecturas';

interface Props {
  titulo: string;
  autora: string;
  color: Color;
  slug?: string;
  class?: string;
}

const { titulo, autora, color, slug, class: className = '' } = Astro.props;

const bg: Record<Color, string> = {
  plum: 'var(--color-plum)',
  orange: 'var(--color-orange)',
  olive: 'var(--color-olive)',
  teal: 'var(--color-teal)',
  navy: 'var(--color-navy)',
  coral: 'var(--color-coral)',
};
---

<div
  class:list={['relative aspect-[3/4.4] rounded-sm shadow-[0_18px_40px_-16px_rgba(42,33,24,0.45)] overflow-hidden flex flex-col justify-between p-4', className]}
  style={{ backgroundColor: bg[color] }}
>
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full opacity-90" aria-hidden="true">
    <circle cx="50" cy="38" r="26" fill="rgba(245,236,219,0.16)" />
    <path d="M0 78 C 25 60, 75 96, 100 70 L100 100 L0 100 Z" fill="rgba(42,33,24,0.18)" />
  </svg>
  <span class="relative font-mono-label text-[0.6rem] uppercase tracking-widest text-cream-soft/80">
    {autora}
  </span>
  <p class="relative font-display text-cream-soft text-lg sm:text-xl leading-[1.05] text-balance drop-shadow-sm">
    {titulo}
  </p>

  {slug && (
    <img
      src={`/covers/${slug}.jpg`}
      alt={`Portada de ${titulo}, de ${autora}`}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
      onerror="this.remove()"
    />
  )}
</div>
