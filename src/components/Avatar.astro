---
// Silueta plana de una integrante del club, al estilo de las ilustraciones
// de "Nuestra historia" en el Instagram: busto de un solo color con
// variación de peinado para que la fila no se vea clonada.
import type { Color } from '../data/lecturas';

interface Props {
  color: Color;
  variant?: 'bob' | 'bun' | 'side' | 'plain';
  class?: string;
}

const { color, variant = 'plain', class: className = '' } = Astro.props;

const fill: Record<Color, string> = {
  plum: 'var(--color-plum)',
  orange: 'var(--color-orange)',
  olive: 'var(--color-olive)',
  teal: 'var(--color-teal)',
  navy: 'var(--color-navy)',
  coral: 'var(--color-coral)',
};
---

<svg viewBox="0 0 40 44" class:list={['block', className]} style={{ color: fill[color] }} aria-hidden="true">
  <path fill="currentColor" d="M2 42c0-11 8-18 18-18s18 7 18 18v2H2z" />
  <circle fill="currentColor" cx="20" cy="15" r="10" />
  {variant === 'bob' && (
    <path
      fill="currentColor"
      d="M8 16a12 12 0 0 1 24 0v6c0 1.5-1.2 2.5-2.5 2.5h-.5v-6a9 9 0 0 0-18 0v6h-.5C9.2 24.5 8 23.5 8 22z"
    />
  )}
  {variant === 'bun' && <circle fill="currentColor" cx="20" cy="3.5" r="4" />}
  {variant === 'side' && (
    <path
      fill="currentColor"
      d="M9 13a11 11 0 0 1 22 0v9c0 1-.6 1.8-1.6 1.8h-1.9v-7.3a8.5 8.5 0 0 0-17 0v2.6c0 .5-.3 1-.7 1.2l-1.3.8c-.7.4-1.5-.1-1.5-.9z"
    />
  )}
</svg>
