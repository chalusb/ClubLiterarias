---
import Squiggle from './Squiggle.astro';
import { club } from '../data/lecturas';
---

<section id="unete" class="relative py-20 sm:py-28 bg-navy overflow-hidden">
  <svg viewBox="0 0 24 24" class="absolute -top-6 -left-6 w-28 h-28 text-plum/40 rotate-12" aria-hidden="true">
    <path fill="currentColor" d="M12 0l1.8 7.6L20 4.4l-4.4 6.2L23 12l-7.4 1.4L20 19.6l-6.2-3.6L12 24l-1.8-7.6L4 19.6l4.4-6.2L1 12l7.4-1.4L4 4.4l6.2 3.6z" />
  </svg>
  <svg viewBox="0 0 24 24" class="absolute bottom-4 right-8 w-16 h-16 text-orange/40 -rotate-6" aria-hidden="true">
    <path fill="currentColor" d="M12 0l1.8 7.6L20 4.4l-4.4 6.2L23 12l-7.4 1.4L20 19.6l-6.2-3.6L12 24l-1.8-7.6L4 19.6l4.4-6.2L1 12l7.4-1.4L4 4.4l6.2 3.6z" />
  </svg>

  <div class="reveal relative mx-auto max-w-2xl px-5 sm:px-8 text-center">
    <span class="font-mono-label text-xs uppercase tracking-widest text-cream-soft/60">Únete al club</span>
    <h2 class="mt-3 font-display text-4xl sm:text-5xl text-cream-soft text-balance">
      ¿Nos acompañas con la próxima lectura?
    </h2>
    <Squiggle color="var(--color-orange)" width={90} class="mt-4 mx-auto squiggle-draw" />
    <p class="mt-6 text-cream-soft/80 leading-relaxed max-w-md mx-auto">
      Cada mes elegimos un libro, nos reunimos a discutirlo y lo documentamos con
      cariño en el Instagram del club. Síguenos para no perderte la próxima ronda.
    </p>

    <a
      href={club.instagram}
      target="_blank"
      rel="noreferrer"
      class="mt-8 inline-flex items-center gap-2 bg-orange text-navy font-mono-label text-xs uppercase tracking-wider px-7 py-3.5 rounded-full transition-[transform,background-color] duration-150 ease-out hover:bg-cream-soft [@media(hover:hover)_and_(pointer:fine)]:hover:-translate-y-0.5"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.97.24 2.43.4a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.16.46.35 1.26.4 2.43.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.97-.4 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.46.16-1.26.35-2.43.4-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.97-.24-2.43-.4a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.16-.46-.35-1.26-.4-2.43C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.24-1.97.4-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.59 1.8c.46-.16 1.26-.35 2.43-.4C9.29 1.34 9.67 2.2 12 2.2Zm0 1.8c-3.14 0-3.5.01-4.73.07-.96.04-1.48.2-1.83.34-.46.18-.78.39-1.13.74-.35.35-.56.67-.74 1.13-.14.35-.3.87-.34 1.83-.06 1.23-.07 1.59-.07 4.73s.01 3.5.07 4.73c.04.96.2 1.48.34 1.83.18.46.39.78.74 1.13.35.35.67.56 1.13.74.35.14.87.3 1.83.34 1.23.06 1.59.07 4.73.07s3.5-.01 4.73-.07c.96-.04 1.48-.2 1.83-.34.46-.18.78-.39 1.13-.74.35-.35.56-.67.74-1.13.14-.35.3-.87.34-1.83.06-1.23.07-1.59.07-4.73s-.01-3.5-.07-4.73c-.04-.96-.2-1.48-.34-1.83a3.09 3.09 0 0 0-.74-1.13 3.09 3.09 0 0 0-1.13-.74c-.35-.14-.87-.3-1.83-.34-1.23-.06-1.59-.07-4.73-.07Zm0 3.24a4.76 4.76 0 1 1 0 9.52 4.76 4.76 0 0 1 0-9.52Zm0 1.8a2.96 2.96 0 1 0 0 5.92 2.96 2.96 0 0 0 0-5.92Zm5.9-1.99a1.11 1.11 0 1 1-2.23 0 1.11 1.11 0 0 1 2.23 0Z"
        />
      </svg>
      Síguenos en Instagram
    </a>
  </div>
</section>
