---
import Logo from './Logo.astro';
import { club } from '../data/lecturas';

const links = [
  { href: '#lectura-del-mes', label: 'Lectura del mes' },
  { href: '#archivo', label: 'Archivo' },
  { href: '#nosotras', label: 'Nosotras' },
  { href: '#unete', label: 'Únete' },
];
---

<header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-sm border-b border-line">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 h-20 flex items-center justify-between gap-4">
    <a href="#top" class="shrink-0">
      <Logo class="h-6 sm:h-7" />
    </a>

    <nav class="hidden md:flex items-center gap-9 font-body text-[0.8rem] text-ink/70">
      {links.map((link) => (
        <a href={link.href} class="link-underline hover:text-ink transition-colors duration-150 ease-out">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={club.instagram}
      target="_blank"
      rel="noreferrer"
      class="hidden sm:inline font-body text-[0.8rem] text-ink link-underline hover:text-plum transition-colors duration-150 ease-out"
    >
      Síguenos
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
      class="md:hidden shrink-0 w-9 h-9 flex flex-col items-center justify-center gap-1.5"
    >
      <span class="menu-bar block w-5 h-px bg-ink transition-transform duration-200 ease-out"></span>
      <span class="menu-bar-2 block w-5 h-px bg-ink transition-opacity duration-150 ease-out"></span>
      <span class="menu-bar block w-5 h-px bg-ink transition-transform duration-200 ease-out"></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden grid border-t border-line bg-paper">
    <nav class="overflow-hidden flex flex-col px-5 py-1 font-body text-sm text-ink/80">
      {links.map((link) => (
        <a href={link.href} class="py-3 border-b border-line last:border-0">
          {link.label}
        </a>
      ))}
      <a href={club.instagram} target="_blank" rel="noreferrer" class="py-3">
        Síguenos en Instagram
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
