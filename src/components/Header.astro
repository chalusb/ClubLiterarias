---
import Logo from './Logo.astro';
import { club } from '../data/lecturas';

const links = [
  { href: '#lectura-del-mes', label: 'Lectura del mes' },
  { href: '#lecturas-anteriores', label: 'Anteriores' },
  { href: '#nosotras', label: 'Nosotras' },
  { href: '#unete', label: 'Únete' },
];
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur-sm border-b border-ink/10">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 h-16 flex items-center justify-between gap-3">
    <a href="#top" class="shrink-0 inline-block [@media(hover:hover)_and_(pointer:fine)]:hover:-rotate-2 transition-transform duration-200 ease-out">
      <Logo class="h-6 sm:h-7" />
    </a>

    <nav class="hidden md:flex items-center gap-7 font-mono-label text-[0.7rem] uppercase tracking-wider text-ink/70">
      {links.map((link) => (
        <a
          href={link.href}
          class="relative py-1 hover:text-plum transition-colors duration-150 ease-out after:content-[''] after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 after:bg-plum after:transition-[width] after:duration-200 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={club.instagram}
        target="_blank"
        rel="noreferrer"
        class="font-mono-label text-[0.65rem] uppercase tracking-wider bg-plum text-cream-soft px-3.5 sm:px-4 py-2 rounded-full hover:bg-plum-deep transition-colors duration-150 ease-out"
      >
        Instagram
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        class="md:hidden shrink-0 w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-full border border-ink/15"
      >
        <span class="menu-bar block w-4 h-[2px] bg-ink transition-transform duration-200 ease-out"></span>
        <span class="menu-bar-2 block w-4 h-[2px] bg-ink transition-opacity duration-150 ease-out"></span>
        <span class="menu-bar block w-4 h-[2px] bg-ink transition-transform duration-200 ease-out"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden grid border-b border-ink/10 bg-cream-soft">
    <nav class="overflow-hidden flex flex-col px-5 py-1 font-mono-label text-xs uppercase tracking-wider text-ink/70">
      {links.map((link) => (
        <a href={link.href} class="py-3 border-b border-ink/5 last:border-0 hover:text-plum">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
