---
// Fila decorativa de asteriscos multicolor, como el separador de las
// publicaciones de Instagram del club.
interface Props {
  class?: string;
  count?: number;
}

const { class: className = '', count = 5 } = Astro.props;
const palette = ['var(--color-plum)', 'var(--color-teal)', 'var(--color-navy)', 'var(--color-orange)', 'var(--color-olive)'];
---

<div class:list={['flex items-center gap-1.5', className]} aria-hidden="true">
  {Array.from({ length: count }).map((_, i) => (
    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" style={{ color: palette[i % palette.length] }}>
      <path
        fill="currentColor"
        d="M12 0l1.8 7.6L20 4.4l-4.4 6.2L23 12l-7.4 1.4L20 19.6l-6.2-3.6L12 24l-1.8-7.6L4 19.6l4.4-6.2L1 12l7.4-1.4L4 4.4l6.2 3.6z"
      />
    </svg>
  ))}
</div>
