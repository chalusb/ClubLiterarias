---
import Squiggle from './Squiggle.astro';
import Stars from './Stars.astro';
import Avatar from './Avatar.astro';
import type { Color } from '../data/lecturas';
import { club, generos } from '../data/lecturas';

const tagColors: Color[] = ['plum', 'orange', 'olive', 'teal', 'navy', 'coral', 'plum'];

type Look = { color: Color; variant: 'bob' | 'bun' | 'side' | 'plain' };

const founders: Look[] = [
  { color: 'navy', variant: 'side' },
  { color: 'olive', variant: 'bob' },
  { color: 'plum', variant: 'bun' },
  { color: 'coral', variant: 'plain' },
  { color: 'teal', variant: 'side' },
];

const now: Look[] = [
  { color: 'navy', variant: 'bob' },
  { color: 'olive', variant: 'side' },
  { color: 'plum', variant: 'plain' },
  { color: 'coral', variant: 'bun' },
  { color: 'teal', variant: 'bob' },
  { color: 'orange', variant: 'side' },
  { color: 'plum', variant: 'side' },
  { color: 'navy', variant: 'plain' },
  { color: 'coral', variant: 'bob' },
  { color: 'teal', variant: 'bun' },
  { color: 'olive', variant: 'plain' },
  { color: 'orange', variant: 'bun' },
];
---

<section id="nosotras" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-lg">
      <span class="font-mono-label text-xs uppercase tracking-widest text-plum">Nuestra historia</span>
      <h2 class="mt-2 font-display text-3xl sm:text-4xl text-navy text-balance">
        Así empezamos, en {club.fundacion}
      </h2>
      <Squiggle color="var(--color-plum)" width={90} class="mt-3 squiggle-draw" />

      <p class="mt-6 text-ink/80 leading-relaxed">
        {club.descripcion}
      </p>
      <p class="mt-4 text-ink/80 leading-relaxed">
        Leemos desde <strong class="text-ink">{club.ciudad}</strong>, México. Aquí compartimos
        historias que nos cuestionan, nos mueven y nos conectan.
      </p>
    </div>

    <div class="mt-14 grid lg:grid-cols-[1.3fr_1fr] gap-10 lg:gap-16 items-start">
      <div class="reveal grid sm:grid-cols-2 gap-8 sm:gap-6" data-reveal-delay="80">
        <div>
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">
            {club.fundacion}, así empezamos
          </p>
          <p class="mt-1 font-display text-4xl text-plum" data-counter={club.integrantesIniciales}>0</p>
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">integrantes</p>
          <div class="mt-4 flex -space-x-2">
            {founders.map((f) => (
              <Avatar color={f.color} variant={f.variant} class="w-11 h-11 shrink-0 drop-shadow-sm" />
            ))}
          </div>
        </div>

        <div>
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">Y ahora somos</p>
          <p class="mt-1 font-display text-4xl text-plum" data-counter={club.integrantes}>0</p>
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">integrantes</p>
          <div class="mt-4 grid grid-cols-6 gap-x-1 gap-y-2 w-max">
            {now.map((f) => (
              <Avatar color={f.color} variant={f.variant} class="w-9 h-9 sm:w-10 sm:h-10 shrink-0" />
            ))}
          </div>
        </div>
      </div>

      <div class="reveal bg-cream-deep/70 rounded-lg border border-ink/10 p-6 relative" data-reveal-delay="140">
        <span class="washi absolute -top-3 left-1/2"></span>
        <p class="font-hand text-2xl leading-snug text-ink/80">
          Historias que nos mueven, nos cuestionan y se quedan.
        </p>
        <div class="mt-5 pt-5 border-t border-ink/10">
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">Hasta la fecha hemos leído</p>
          <p class="mt-1 font-display text-5xl sm:text-6xl text-orange" data-counter={club.librosLeidos}>0</p>
          <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-ink/50">libros</p>
        </div>
      </div>
    </div>

    <div class="reveal mt-14" data-reveal-delay="180">
      <div class="flex flex-wrap gap-2">
        {generos.map((g, i) => (
          <span
            class="tag-pop font-mono-label text-[0.65rem] uppercase tracking-wide px-3 py-1.5 rounded-full border"
            style={`color: var(--color-${tagColors[i % tagColors.length]}); border-color: var(--color-${tagColors[i % tagColors.length]}); --pop-delay: ${i * 60}ms`}
          >
            {g}
          </span>
        ))}
      </div>

      <Stars class="mt-8" />
    </div>
  </div>
</section>
