---
import { club, generos } from '../data/lecturas';
---

<section id="nosotras" class="py-20 sm:py-28 border-t border-line bg-paper-deep/60">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-xl">
      <p class="font-mono-label text-xs uppercase tracking-[0.25em] text-plum">Nosotras</p>
      <h2 class="mt-3 font-display text-3xl sm:text-5xl text-balance">
        Así empezamos, en {club.fundacion}
      </h2>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-px bg-line">
      <div class="reveal bg-paper p-8 sm:p-10" data-reveal-delay="0">
        <p class="font-mono-label text-[0.7rem] uppercase tracking-wide text-ink-soft">Nuestra historia</p>
        <p class="mt-4 font-display text-xl leading-snug text-balance">
          {club.descripcion}
        </p>
        <p class="mt-4 text-sm text-ink-soft leading-relaxed">
          Leemos desde {club.ciudad}, México.
        </p>
      </div>

      <div class="reveal bg-paper p-8 sm:p-10" data-reveal-delay="80">
        <p class="font-mono-label text-[0.7rem] uppercase tracking-wide text-ink-soft">Cómo hemos crecido</p>
        <div class="mt-6 flex items-end gap-3">
          <span class="font-display text-5xl" data-counter={club.integrantesIniciales}>0</span>
          <span class="pb-1 text-sm text-ink-soft">→</span>
          <span class="font-display text-5xl text-plum" data-counter={club.integrantes}>0</span>
        </div>
        <p class="mt-2 font-mono-label text-[0.65rem] uppercase tracking-wide text-ink-soft">
          Integrantes desde {club.fundacion}
        </p>
        <p class="mt-6 font-display text-5xl" data-counter={club.librosLeidos}>0</p>
        <p class="mt-2 font-mono-label text-[0.65rem] uppercase tracking-wide text-ink-soft">Libros leídos</p>
      </div>

      <div class="reveal bg-paper p-8 sm:p-10" data-reveal-delay="160">
        <p class="font-mono-label text-[0.7rem] uppercase tracking-wide text-ink-soft">Lo que leemos</p>
        <ul class="mt-5 flex flex-col gap-3">
          {generos.map((g, i) => (
            <li class="flex items-center justify-between border-b border-line pb-2 font-display text-lg">
              {g}
              <span class="font-mono-label text-[0.65rem] text-ink-soft">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
