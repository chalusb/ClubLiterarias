---
import { biblioteca } from '../data/biblioteca';
---

<section id="biblioteca" class="py-20 sm:py-28 border-t border-dashed border-line">
  <h2 class="reveal font-display headline text-4xl sm:text-5xl text-center text-balance">
    Nuestra biblioteca
  </h2>

  <div class="mt-14 mx-auto max-w-6xl px-5 sm:px-8 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-10">
    {biblioteca.map((libro, i) => (
      <div
        class="reveal book-in"
        style={`--slide-x: ${i % 2 === 0 ? '-46px' : '46px'}; --slide-rot: ${i % 2 === 0 ? '-6deg' : '6deg'}`}
        data-reveal-delay={Math.min((i % 12) * 30, 250)}
      >
        <img
          src={`/biblioteca/${libro.slug}.jpg`}
          alt={`Portada de ${libro.titulo}, de ${libro.autor}`}
          loading="lazy"
          decoding="async"
          width="420"
          height="600"
          class="w-full aspect-[7/10] object-cover"
        />
        <p class="mt-3 font-display font-bold text-sm leading-snug text-balance">{libro.titulo}</p>
      </div>
    ))}
  </div>
</section>
