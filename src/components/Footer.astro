---
import { club } from '../data/lecturas';
const year = new Date().getFullYear();

const links = [
  { href: '#lectura-del-mes', label: 'Lectura del mes' },
  { href: '#archivo', label: 'Archivo' },
  { href: '#nosotras', label: 'Nosotras' },
  { href: '#unete', label: 'Únete' },
];
---

<footer class="bg-ink border-t border-paper/15 pt-16 pb-8">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 grid sm:grid-cols-[1.2fr_1fr_1fr] gap-10 sm:gap-6">
    <div>
      <p class="font-display headline text-2xl text-paper">LITERARIAS</p>
      <p class="mt-4 max-w-xs text-sm text-paper/60 leading-relaxed">
        Club de lectura fundado en {club.fundacion} en {club.ciudad}, México.
      </p>
    </div>

    <div>
      <p class="font-display font-bold uppercase text-xs tracking-[-0.02em] text-paper/50">Sitio</p>
      <ul class="mt-4 flex flex-col gap-2.5">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-paper/70 hover:text-paper transition-colors duration-150 ease-out">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-display font-bold uppercase text-xs tracking-[-0.02em] text-paper/50">Redes</p>
      <ul class="mt-4 flex flex-col gap-2.5">
        <li>
          <a
            href={club.instagram}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-paper/70 hover:text-paper transition-colors duration-150 ease-out"
          >
            @club.literarias
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8 mt-14 pt-6 border-t-2 border-dashed border-paper/40 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-paper/40">
      {club.ciudad} · © {year}
    </p>
    <p class="font-mono-label text-[0.65rem] uppercase tracking-wider text-paper/40">
      Desarrollado por{' '}
      <a
        href="https://cssoftware.org"
        target="_blank"
        rel="noreferrer"
        class="text-paper/70 hover:text-paper transition-colors duration-150 ease-out"
      >
        cssoftware.org
      </a>
    </p>
  </div>
</footer>
