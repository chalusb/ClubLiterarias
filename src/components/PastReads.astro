---
import BookCover from './BookCover.astro';
import StarRating from './StarRating.astro';
import { lecturasAnteriores } from '../data/lecturas';
---

<section id="archivo" class="py-20 sm:py-28 border-t border-line">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal flex items-end justify-between gap-6 flex-wrap">
      <div>
        <p class="font-mono-label text-xs uppercase tracking-[0.25em] text-plum">Archivo</p>
        <h2 class="mt-3 font-display text-3xl sm:text-5xl text-balance">Lecturas anteriores</h2>
      </div>
      <p class="max-w-xs text-sm text-ink-soft">
        Desliza para ver los libros que nos han hecho reunirnos, desde nuestro primer mes hasta hoy.
      </p>
    </div>

    <div class="mt-12 -mx-5 sm:-mx-8 px-5 sm:px-8 flex gap-8 overflow-x-auto snap-x snap-mandatory pb-4 [scrollbar-width:thin]">
      {lecturasAnteriores.map((l, i) => (
        <article class="reveal snap-start shrink-0 w-44 sm:w-52" data-reveal-delay={Math.min(i * 50, 250)}>
          <BookCover titulo={l.titulo} autora={l.autora} color={l.color} slug={l.slug} class="w-full" />
          <p class="mt-4 font-mono-label text-[0.65rem] uppercase tracking-wide text-ink-soft">
            {l.mes} {l.anio}
          </p>
          <h3 class="mt-1 font-display text-base leading-snug text-balance">{l.titulo}</h3>
          <p class="text-sm text-ink-soft">{l.autora}</p>
          <StarRating value={l.veredicto} color="var(--color-plum)" class="mt-2 scale-90 origin-left" />
        </article>
      ))}
    </div>
  </div>
</section>
