---
interface Props {
  value: number;
  max?: number;
  color?: string;
  class?: string;
}

const { value, max = 5, color = 'var(--color-orange)', class: className = '' } = Astro.props;
---

<div class:list={['flex items-center gap-1', className]} role="img" aria-label={`Veredicto: ${value} de ${max} estrellas`}>
  {Array.from({ length: max }).map((_, i) => (
    <svg viewBox="0 0 24 24" class="w-4 h-4" style={{ color }} aria-hidden="true">
      {i < value ? (
        <path
          fill="currentColor"
          d="M12 1.5l3.1 6.6 7.2.8-5.4 4.9 1.5 7.1-6.4-3.7-6.4 3.7 1.5-7.1-5.4-4.9 7.2-.8z"
        />
      ) : (
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          d="M12 1.5l3.1 6.6 7.2.8-5.4 4.9 1.5 7.1-6.4-3.7-6.4 3.7 1.5-7.1-5.4-4.9 7.2-.8z"
        />
      )}
    </svg>
  ))}
</div>
