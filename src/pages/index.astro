---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout description="Club de lectura en Chihuahua, Chih. Muy pronto, nuestro sitio.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <Logo class="h-14 sm:h-20" />
    <p class="mt-8 font-mono-label text-xs sm:text-sm uppercase tracking-[0.3em] text-ink/60">
      Próximamente
    </p>
  </main>
</Layout>
