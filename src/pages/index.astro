import Biblioteca from '../components/Biblioteca.astro';
import About from '../components/About.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <div id="top">
    <Header />
    <main>
      <Hero />
      <PastReads />
      <Biblioteca />
      <About />
      <Join />
    </main>
    <Footer />
  </div>
</Layout>
